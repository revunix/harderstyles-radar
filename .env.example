# Copy to .env and fill in. Real environment variables override this file.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# printed by `go run ./cmd/hardstyle-playlist-sync -auth`
SPOTIFY_REFRESH_TOKEN=
# open.spotify.com/playlist/<ID>
SPOTIFY_PLAYLIST_ID=
# optional fallback apps, used one after the other when Spotify blocks the app above (rate limit is per app).
# Each app needs its own refresh token: run with -auth -auth-slot 2 (3, ...). Same Spotify account, same playlist.
#SPOTIFY_CLIENT_ID_2=
#SPOTIFY_CLIENT_SECRET_2=
#SPOTIFY_REFRESH_TOKEN_2=

# optional
GENRES=all               # any = the general list, whatever the genre; all = every genre; or a list: Hardstyle,Hardcore,Uptempo,Frenchcore,Freestyle,Hard Dance,Hard Techno,UK/Happy Hardcore
PAGES=2                 # 30 tracks per page and genre
MAX_TRACKS=500
# language of the interface, the log and the messages: de or en
UI_LANGUAGE=de

# service: check hardstyle.com for new tracks this often (15m); 0 = off. Without the interface use -watch 15m
WATCH_INTERVAL=15m
ALBUM_MIN_TRACKS=2        # this many tracks with the same catalog number = an album, all taken from one Spotify album (0 = off)

# slow and small on purpose, Spotify blocks apps that ask too much
MAX_SEARCHES=100          # Spotify lookups per run, the rest waits for the next run
CONTINUE_DELAY=10m        # pause before the next run when releases are left over or a run failed
REQUEST_DELAY=800ms       # pause between two Spotify requests
DATE_TOLERANCE_DAYS=14    # how far the Spotify date may be from the date on hardstyle.com; a fitting title and artist is taken up to 45 days off

# remembers which releases are already looked up, so a daily run only searches the new ones
CACHE_FILE=.hardstyle-sync-cache.json

# description of the playlist, in English by default; {date} {max} {source} are filled in, "off" leaves it alone
#PLAYLIST_DESCRIPTION=Daily updated from hardstyle.com. Last update: {date}
